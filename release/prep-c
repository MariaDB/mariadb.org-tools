#!/bin/bash - 
#===============================================================================
#
#          FILE:  prep-c
# 
#         USAGE:  ./prep-c <version> <tarbuildnum>
# 
#   DESCRIPTION:  This script is used to prepare files for a MariaDB
#                 Connector/C release
# 
#        AUTHOR: Daniel Bartholomew
#       CREATED: 17/05/23 00:56:37 EST
#===============================================================================


#-------------------------------------------------------------------------------
#  Variables
#-------------------------------------------------------------------------------
version=${1}
tarbuildnum=${2}

dir_name="connector-c-${version}"

# set location of prep.conf and prep.log to XDG-compatible directories and then
# create them if they don't exist
dir_conf=${XDG_CONFIG_HOME:-~/.config}
dir_log=${XDG_DATA_HOME:-~/.local/share}

# ${dir_conf}/common provides RC, DIV, LINE, THICKLINE, PAUSE, MSG, MSG_I,
# MSG_L, userResponse, userInput and rsync_wrapper. This script used to carry
# its own copies of all of them; it now sources them here -- before the function
# definitions and the main script -- so they are available to every code path.
if [ -f ${dir_conf}/common ]; then
  . ${dir_conf}/common
else
  echo
  echo "The file ${dir_conf}/common does not exist."
  echo "It provides RC, DIV, MSG, LINE and userResponse, which this script"
  echo "cannot run without. Please install it and re-run."
  echo
  exit 3
fi


#-------------------------------------------------------------------------------
#  Functions
#-------------------------------------------------------------------------------
sumgen() {
  for sum in md5 sha1 sha256 sha512;do
	echo;LINE;echo ${sum};
	${sum}sum ./mar* >> ${sum}sums.txt
	${sum}sum -c ${sum}sums.txt
  done
  DIV
}

loadDefaults() {
  # Load the paths (if they exist)
  if [ -f ${dir_conf}/prep.conf ]; then
      . ${dir_conf}/prep.conf
  else
    echo
    echo "The file ${dir_conf}/prep.conf does not exist in your home."
    echo "The prep script creates a default template of this file when run."
    echo "Exiting..."
    exit 1
  fi
}

usage() {
  DIV
  echo "usage: $0 <version> <tarbuildnum>"
  echo " e.g.: $0 3.4.11 121"
  echo
  echo "<tarbuildnum> is the build number under ${cc_url:-\${cc_url}}/"
  echo;LINE
  echo
  exit 1
}


shouldI() {
  local cont
  cont=""
   while [ -z ${cont} ]; do
     userResponse "Should I ${@//_/ }? [y/n]"
     case ${ANSWER} in
      "y")
        ${@}
        cont="yes"
        return 0
        ;;
      "n")
        echo "Skipping . . . "
        cont="yes"
        return 0
        ;;
      *)
        echo "Please answer [y]es or [n]o."
        echo
        cont=""
        ;;
    esac
  done
}

#===  FUNCTION  ================================================================
#          NAME:  download_files_from_ci
#   DESCRIPTION:  Mirror this build's artifacts from ci.mariadb.org into
#                 ${cc_builds}/${tarbuildnum}. The packages used to be read
#                 straight off a local buildbot archive path; they are now
#                 pulled down here first, exactly as prep-odbc and prep-cpp do.
#===============================================================================
download_files_from_ci() {
  MSG "Downloading files from CI"
  pushd ${cc_builds}
    RC wget2 --progress=bar --no-robots --cut-dirs=1 --no-parent -r -N --no-host-directories ${cc_url}/${tarbuildnum}/
  popd
}

copy_win_packages_to_sign-todo_dir() {
  RC cp -avi ${dir_build}/cc-x86-windows/*.msi ~/sign-todo/
  RC cp -avi ${dir_build}/cc-amd64-windows/*.msi ~/sign-todo/
  RC tree ~/sign-todo/
  MSG "Quitting so Win Package signing can occur."
  MSG_L "Re-run script when signing is completed and move signed packages back."
  exit 0
}

#===  FUNCTION  ================================================================
#          NAME:  move_win_packages_from_sign-done_dir
#   DESCRIPTION:  Move the signed .msi packages out of ~/sign-done and into
#                 ${dir_win_signed}.
#
#                 They deliberately do NOT go back into the ci download dirs
#                 they came from. Everything under ${cc_builds}/${tarbuildnum}
#                 is re-fetched by download_files_from_ci, and wget2 -N will
#                 pull a file again when the local copy differs in size, which
#                 a signed .msi always does -- so a later download would drop
#                 the unsigned .msi straight back on top of the signed one.
#                 ${dir_win_signed} sits beside that tree rather than inside
#                 it, so nothing download_files_from_ci does can reach it.
#===============================================================================
move_win_packages_from_sign-done_dir() {
  RC tree ~/sign-done/
  if [ ! -d ${dir_win_signed} ]; then
    mkdir -vp ${dir_win_signed}
  fi
  RC mv -vi ~/sign-done/mariadb-connector-c-*${version}*win32.msi ${dir_win_signed}/
  RC mv -vi ~/sign-done/mariadb-connector-c-*${version}*win64.msi ${dir_win_signed}/
  RC tree ${dir_win_signed}/
  RC tree ~/sign-done/
}

verify_signed_win_packages() {
  local missing
  missing=""
  for arch in win32 win64 ; do
    if ! compgen -G "${dir_win_signed}/*${arch}.msi" > /dev/null ; then
      missing="${missing} ${arch}"
    fi
  done
  if [ -n "${missing}" ]; then
    MSG_I "No signed${missing} .msi in ${dir_win_signed}"
    MSG_L "Both .msi packages have to be signed before the release can be"
    MSG_L "built: run the sign-todo copy, get them signed, then run the"
    MSG_L "sign-done move. Quitting..."
    exit 9
  fi
  for msi in ${dir_win_signed}/*msi ; do
    MSG "Verifying ${msi}"
    RC osslsigncode verify -in ${msi}
  done
}

#===  FUNCTION  ================================================================
#          NAME:  copy_and_stage_files
#   DESCRIPTION:  Stage the downloaded build into ${cc_home}/${dir_name}.
#                 Each builder directory is kept as a directory rather than
#                 being flattened: ci names the aarch64 and amd64 tarballs
#                 identically (e.g. both cc-aarch64-debian-12 and
#                 cc-amd64-debian-12 hold mariadb-connector-c-X-debian12.tar.gz)
#                 so flattening them would silently lose half the packages.
#===============================================================================
copy_and_stage_files() {
  MSG "Copying and staging files"
  pushd ${cc_home}
    if [[ ! -d "${dir_name}" ]];then
      mkdir -v ${dir_name}
    fi
    for dir in ${dir_build}/cc-* ; do
      case $(basename ${dir}) in
        cc-*-windows)
          # The .msi in the ci download dir is the unsigned one. Exclude it
          # here and take the signed .msi from ${dir_win_signed} below. Not
          # using RC for this one: it runs its arguments unquoted, which would
          # let the shell expand the *.msi exclude pattern against the cwd.
          echo "+ rsync -av --exclude=index.html --exclude=*.msi ${dir} ${dir_name}/"
          rsync -av --exclude=index.html --exclude='*.msi' "${dir}" "${dir_name}/"
          ;;
        *)
          RC rsync -av --exclude=index.html ${dir} ${dir_name}/
          ;;
      esac
      DIV
    done

    # The Windows packages are the signed ones from ${dir_win_signed}, NOT the
    # unsigned ones sitting in the ci download dir.
    if ! compgen -G "${dir_win_signed}/*msi" > /dev/null ; then
      MSG "No signed .msi in ${dir_win_signed}, refusing to stage the release"
      MSG_L "without the Windows packages. Get them signed first."
      return 1
    fi
    for msi in ${dir_win_signed}/*msi ; do
      case $(basename ${msi}) in
        *win32.msi) win_dir="cc-x86-windows"   ;;
        *win64.msi) win_dir="cc-amd64-windows" ;;
        *)
          MSG "Do not know where to stage $(basename ${msi}). Quitting..."
          return 1
          ;;
      esac
      if [[ ! -d "${dir_name}/${win_dir}" ]] ; then
        mkdir -v ${dir_name}/${win_dir}
      fi
      RC cp -avi ${msi} ${dir_name}/${win_dir}/
    done
    DIV

    # Src files. ci publishes the source tarball at the top of the build dir.
    RC cp -avi ${dir_build}/*src.tar.gz ${dir_name}/
    # ci does not build a source .zip; create_the_source_zip_from_the_source_
    # tarball makes one in the next step. Copy one in anyway if ci ever starts
    # publishing its own, so the generated one is never preferred over it.
    if compgen -G "${dir_build}/*src.zip" > /dev/null ; then
      RC cp -avi ${dir_build}/*src.zip ${dir_name}/
    else
      MSG_L "No source .zip in ${dir_build}, one will be built from the tarball..."
    fi

    tree ${dir_name}/
  popd
  echo;echo;echo
}

#===  FUNCTION  ================================================================
#          NAME:  create_the_source_zip_from_the_source_tarball
#   DESCRIPTION:  ci publishes a source .tar.gz for connector/c but no source
#                 .zip, and mariadb.org has always served both. The two have
#                 held identical trees historically -- the published 3.4.9
#                 .zip and .tar.gz unpack to trees `diff -r` reports as
#                 identical, same 521 entries, no line-ending conversion -- so
#                 the .zip is repacked here from the .tar.gz rather than
#                 fetched from anywhere. The entry lists are compared
#                 afterwards, and a mismatched .zip is deleted rather than
#                 shipped, so a partial repack is caught here and not on the
#                 mirrors.
#
#                 An existing .zip is left alone, so a real one from ci (see
#                 copy_and_stage_files) always wins over a generated one.
#===============================================================================
create_the_source_zip_from_the_source_tarball() {
  local tarball
  local zipfile
  local src_dir
  local tmp_dir

  for cmd in zip unzip ; do
    if ! command -v ${cmd} > /dev/null ; then
      MSG "${cmd} is not installed, cannot build the source .zip."
      return 1
    fi
  done

  tarball=$(ls ${cc_home}/${dir_name}/*src.tar.gz)
  zipfile="${tarball%.tar.gz}.zip"

  if [[ -f "${zipfile}" ]] ; then
    MSG_L "Found an existing $(basename ${zipfile}), not rebuilding it..."
    return 0
  fi

  MSG "Building $(basename ${zipfile}) from $(basename ${tarball})"
  src_dir=$(basename ${tarball} .tar.gz)
  tmp_dir=$(mktemp -d)
  RC tar -xzf ${tarball} -C ${tmp_dir}
  if [[ ! -d "${tmp_dir}/${src_dir}" ]] ; then
    MSG "$(basename ${tarball}) does not unpack to ${src_dir}/, not building a .zip."
    rm -rf ${tmp_dir}
    return 1
  fi
  pushd ${tmp_dir}
    RC zip -q -r -X ${zipfile} ${src_dir}
  popd
  rm -rf ${tmp_dir}

  MSG_L "Checking the .zip holds what the .tar.gz holds..."
  if diff <(tar -tzf ${tarball} | sed 's|/$||' | sort -u) \
          <(unzip -Z1 ${zipfile} | sed 's|/$||' | sort -u) ; then
    MSG_L "The .zip and the .tar.gz hold the same files."
    RC ls -l ${tarball} ${zipfile}
  else
    MSG "The .zip does not match the .tar.gz. Removing it."
    rm -f ${zipfile}
    return 1
  fi
  echo;echo;echo
}

prep_org_files() {
  # Prep .org files
  MSG "Prepping org files"
  if [[ ! -d "${cc_home_org}/${dir_name}" ]];then
    mkdir -v ${cc_home_org}/${dir_name}
  fi
  cp -avi ${cc_home}/${dir_name}/*src* ${cc_home_org}/${dir_name}/
  pushd ${cc_home_org}/${dir_name}
    sumgen
    for file in *;do
      echo "+ gpg ${gpg_opts} ${file}"
              gpg ${gpg_opts} ${file}
    done
  popd
  echo;echo;echo
}

update_org_current_to_this_release() {
  if [[ -d ${cc_home_org}/connector-c-current ]]; then
    rm -rf ${cc_home_org}/connector-c-current
  fi
  MSG "Updating current org release to this one..."
  RC mkdir ${cc_home_org}/connector-c-current
  RC cp -avi ${cc_home}/${dir_name}/*src.tar.gz ${cc_home_org}/connector-c-current/mariadb-connector-c-current-src.tar.gz
  if compgen -G "${cc_home}/${dir_name}/*src.zip" > /dev/null ; then
    RC cp -avi ${cc_home}/${dir_name}/*src.zip ${cc_home_org}/connector-c-current/mariadb-connector-c-current-src.zip
  else
    MSG_L "No source .zip staged, not publishing a -current-src.zip..."
    MSG_L "Re-run the create the source zip step if that was not deliberate."
  fi
  pushd ${cc_home_org}/connector-c-current/
    sumgen
    for file in *;do
      echo "+ gpg ${gpg_opts} ${file}"
              gpg ${gpg_opts} ${file}
    done
  popd
  echo;echo;echo
}

prep_com_files() {
  # Prep .com files
  MSG "Prepping com files"
  pushd ${cc_home}/${dir_name}
    sumgen
    # The per-builder packages live one level down now, so sign both the
    # top-level source archives and everything inside the builder dirs.
    for file in *tar.gz *zip */* ;do
      [[ -f "${file}" ]] || continue
      RC gpg ${ent_gpg_opts} ${file}
    done
  popd
  echo;echo;echo
}

upload_to_the_primary_mirror() {
  rsync_wrapper "-av --delete-after ${cc_home_org}/${dir_name} ${cc_home_org}/connector-c-current ${primary_mirror}:data/"
}

upload_to_staging() {
  rsync_wrapper "-av --delete-after ${cc_home}/${dir_name} ${cc_home_corp_staging}/"
}

upload_to_prod() {
  rsync_wrapper "-av --delete-after ${cc_home}/${dir_name} ${cc_home_corp}/"
}

#===  FUNCTION  ================================================================
#          NAME:  generate_the_file_list_pickle_for_org_downloads
#   DESCRIPTION:  This function logs in to the primary mirror and runs the
#                 command to generate the pickle that is then imported into the
#                 mariadb.org downloads system.
#===============================================================================
generate_the_file_list_pickle_for_org_downloads() {
  ssh -t -t ${primary_mirror} "set -x; python generate_file_list.py data/ --release=${dir_name}";
}

#===  FUNCTION  ================================================================
#          NAME:  update_the_STATUS_file
#   DESCRIPTION:  Simple function to update a STATUS file with a UNIX timestamp
#===============================================================================
update_the_STATUS_file() {
  echo "+ date +%s > ${cc_home_org}/STATUS"
          date +%s > ${cc_home_org}/STATUS
  MSG "STATUS file updated"
}

#===  FUNCTION  ================================================================
#          NAME:  uploader
#   DESCRIPTION:  Upload a release
#===============================================================================
uploader() {
  local dest
  local dests
  local rsync_uploader_opts
  dests="$@"
  rsync_uploader_opts="-av --delete-before --exclude=TIME --exclude=exclude --exclude=*orig"
  for dest in ${dests} ; do
    local cont
    cont=""
    while [ -z ${cont} ]; do
      userResponse "Should I upload to ${dest}? [y/n]"
      case ${ANSWER} in
        y)
          MSG "Uploading to ${dest}..."
          case ${dest} in
            *hz-archive*)
              rsync_uploader_opts="${rsync_uploader_opts} --no-group --no-owner --no-perms"
              ;;
          esac
          rsync_wrapper "${rsync_uploader_opts} ${cc_home_org}/${dir_name} ${dest}/"
          rsync_wrapper "${rsync_uploader_opts} ${cc_home_org}/connector-c-current ${dest}/"
          cont="yes"
          ANSWER=""
          ;;
        n)
          MSG "Skipping uploading to ${dest}..."
          cont="yes"
          ANSWER=""
          ;;
        *)
          MSG_L "Please answer [y]es or [n]o."
          cont=""
          ANSWER=""
          ;;
      esac
    done
  done
}

# Wrapper functions for uploader
upload_to_the_mirrors() {
  uploader "${mirrors_foundation}"
}

upload_to_the_archives() {
  uploader "${archives_foundation}"
}

#===  FUNCTION  ================================================================
#          NAME:  remove_a_dir_from_the_local_mirror_dir
#   DESCRIPTION:  This function displays the dirs in the ${dir_local_mirror}
#                 directory and prompts for a dir to release, repeating until
#                 you answer 'n'.
#===============================================================================
remove_a_dir_from_the_local_mirror_dir() {
  local done_removing
  done_removing=""
  while [ -z ${done_removing} ];do
    MSG "Releases currently in ${dir_local_mirror}"
    tree -L 1 ${dir_local_mirror}
    LINE
    userInput "What release should I remove? (e.g. mariadb-10.6.7, s to stop)"
    release_to_remove="${INPUT}"
    if [ -z ${release_to_remove} ] ; then
      MSG "Please enter a release or 's' to stop."
    else
      case ${release_to_remove} in
        s)
          MSG_L "Stopping..."
          done_removing='yes'
          ;;
        *)
          if [ -d ${dir_local_mirror}/${release_to_remove} ] ; then
            userResponse "Ok to remove ${release_to_remove}? [y/n]"
            case ${ANSWER} in
              y)
                MSG_L "Removing ${release_to_remove}..."
                RC rm -rf ${dir_local_mirror}/${release_to_remove}
                ;;
              n)
                MSG_L "Not removing ${release_to_remove}"
                ;;
              *)
                MSG_L "Please answer [y]es or [n]o."
                ;;
            esac
          else
            MSG_L "${release_to_remove} doesn't appear to exist, please try again."
            PAUSE
          fi
          done_removing=""
          ;;
      esac
    fi
  done
}

#===  FUNCTION  ================================================================
#          NAME:  copy_the_release_to_the_local_mirror_dir
#   DESCRIPTION:  Copy the release to the local mirror prep directory
#===============================================================================
copy_the_release_to_the_local_mirror_dir() {
  if [[ -d ${dir_local_mirror}/${dir_name} ]] ; then
    MSG_L "Found existing ${dir_name} under ${dir_local_mirror}/, not copying..."
  else
    RC cp -ail ${cc_home_org}/${dir_name} ${dir_local_mirror}/
  fi
  RC rsync -av ${cc_home_org}/connector-c-current ${dir_local_mirror}/
  verify_local_mirror_copy_is_good
}

verify_local_mirror_copy_is_good() {
  local dry_run_status
  dry_run_status=""
  MSG "Doing an rsync dry-run to verify the local mirror copy is good"
  MSG_L "If rsync doesn't find anything to sync then the copy is good."
  for dir in ${dir_name} connector-c-current ; do
    RC rsync --dry-run -avP ${cc_home_org}/${dir} ${dir_local_mirror}/
    LINE
  done
  while [ -z ${dry_run_status} ]; do
    userResponse "Did the dry run look OK? [y/n]"
    case ${ANSWER} in
      "y")
        MSG_L "Local mirror copy is good..."
        dry_run_status="yes"
        ANSWER=""
        return 0
        ;;
      "n")
        MSG_L "Local mirror copy is not good. Something went wrong..."
        MSG_L "You might want to delete the local mirror copy and re-run this step"
        ANSWER=""
        exit 1
        ;;
      *)
        echo "Please answer [y]es or [n]o."
        echo
        dry_run_status=""
        ;;
    esac
  done
}



#-------------------------------------------------------------------------------
# Main Script
#-------------------------------------------------------------------------------

loadDefaults

dir_build="${cc_builds}/${tarbuildnum}"
# Beside the ci download tree, never inside it -- see
# move_win_packages_from_sign-done_dir.
dir_win_signed="${cc_builds}/signed/${tarbuildnum}"

case ${version} in
  ""|"-h"|"--help") usage
    ;;
esac

if [ "${tarbuildnum}" = "" ]; then
  usage
fi

set -eu
  # -e  Exit immediately if a simple command exits with a non-zero status,
  #     unless the command that fails is part of an until or  while loop, part
  #     of an if statement, part of a && or || list, or if the command's return
  #     status is being inverted using !.  -o errexit
  #
  # -u  Treat unset variables as an error when performing parameter expansion.
  #     An error message will be written to the standard error, and a
  #     non-interactive shell will exit.
  #
  # -x  Print a trace of simple commands and their arguments after they are
  #     expanded and before they are executed.

MSG_I "Preparing MariaDB Connector/C ${version} release..."
echo;echo
shouldI download_files_from_ci
echo;echo
shouldI copy_win_packages_to_sign-todo_dir
echo;echo
shouldI move_win_packages_from_sign-done_dir
echo;echo
verify_signed_win_packages
echo;echo
shouldI copy_and_stage_files
echo;echo
shouldI create_the_source_zip_from_the_source_tarball
echo;echo
shouldI prep_org_files
echo;echo
shouldI update_org_current_to_this_release
echo;echo
shouldI prep_com_files
echo;echo
shouldI upload_to_staging
echo;echo
shouldI upload_to_prod
echo;echo

MSG_I "Mirrors"
for mirror in ${mirrors_foundation} ; do echo "- ${mirror}";done;echo
shouldI upload_to_the_mirrors
echo;echo
MSG_I "Archives"
for archive in ${archives_foundation} ; do echo "- ${archive}";done;echo
shouldI upload_to_the_archives

shouldI copy_the_release_to_the_local_mirror_dir
shouldI remove_a_dir_from_the_local_mirror_dir

MSG_I "All done!"
LINE;LINE;LINE
echo;echo;echo

