#-------------------------------------------------------------------------------
# Common functions used by the release prep scripts
#-------------------------------------------------------------------------------
# Symlink this file under `~/.config/`, e.g.:
#   cd ~/.config
#   ln -sv /path/to/mariadb.org-tools/release/common ./

DIV() { echo;echo;LINE;echo;echo;}
DIV_I() { echo;echo;THICKLINE;echo;echo;}
SPACE() { echo;echo;echo;}
LINE() { echo -n '#';for i in {1..77} ; do echo -n '-';done;echo '-';}
THICKLINE() { echo -n '#';for i in {1..77} ; do echo -n '=';done;echo '=';}
RC() { echo "+ ${@}";if ${@};then return 0;else return 1;fi;}
PAUSE() { echo;read -p "Press any key to continue." -n 1;echo;return 0;}

MSG() { LINE;echo -e "# ${@}";LINE;}
MSG_I() { echo;echo;THICKLINE;echo -e "# ${@}";THICKLINE;}
MSG_L() { echo -e "# ${@}";}

userResponse() {
  question="${@}"
  read -p "${question} " -n 1
  echo
  ANSWER=${REPLY}
  RESPONSE=${REPLY}
  return 0
}

userInput() {
  question="$@"
  echo
  read -p "${question} "
  echo
  INPUT=${REPLY}
  return 0
}

secureUserInput() {
  question="${@}"
  SECUREINPUT="false"
  REPLY="alsofalse"
  while [ "${SECUREINPUT}" != "${REPLY}" ]; do
    read -s -p "${question} "
    echo
    SECUREINPUT="${REPLY}"
    read -s -p "Please enter it again: "
    echo
    if [ "${SECUREINPUT}" != "${REPLY}" ]; then
      echo
      echo "The two entries do not match."
      echo
    else
      echo
      echo "The two entries match. Continuing."
      echo
      return 0
    fi
  done
}

#---  FUNCTION  ----------------------------------------------------------------
#          NAME:  rsync_wrapper
#   DESCRIPTION:  This function provides a safety net for using rsync. It takes
#                 the options part of the rsync (everything that would come
#                 after the rsync command itself on the command-line) and first
#                 runs it with the --dry-run flag. It then asks if everything
#                 is OK. Assuming things are OK, it runs the rsync for real.
#
#                 The dry run is paged through ${PAGER:-less} so a long file
#                 list can be read from the top. Piping into a pager would
#                 normally hide rsync's exit status behind the pager's, so the
#                 pipeline runs in a subshell with pipefail set -- a subshell so
#                 pipefail cannot leak into the script that sourced this file --
#                 and a failed dry run returns without offering to transfer.
#                 stderr is folded into the paged output so the reason is
#                 visible there rather than scrolling past behind the pager.
#-------------------------------------------------------------------------------
rsync_wrapper() {
  local upload
  upload=""
  rsync_body="${@}"
  MSG_L "Doing a dry run..."
  echo "+ rsync --dry-run ${rsync_body}"
  if ! ( set -o pipefail; rsync --dry-run ${rsync_body} 2>&1 | ${PAGER:-less} ); then
    MSG "The dry run itself failed. Not transferring."
    return 1
  fi
  echo
  while [ -z ${upload} ]; do
    userResponse "Did the dry run look OK? [y/n]"
    case ${ANSWER} in
      "y")
        MSG_L "Transferring for real..."
        RC rsync ${rsync_body}
        echo
        upload="yes"
        ANSWER=""
        return 0
        ;;
      "n")
        MSG "Something went wrong..."
        upload="no"
        ANSWER=""
        return 1
        ;;
      *)
        echo "Please answer [y]es or [n]o."
        echo
        upload=""
        ;;
    esac
  done
}

#---  FUNCTION  ----------------------------------------------------------------
#          NAME:  STAGE_DIR_NAME
#   DESCRIPTION:  Turn a ci builder directory name into the name it should be
#                 staged under in a release tree, and echo it.
#
#                 ci names its builder dirs <connector>-<arch>-<dist>-<ver>,
#                 e.g. cc-aarch64-ubuntu-24.04, or <connector>-<arch>-windows
#                 for the Windows builders. Staged as-is, a release sorts by
#                 architecture, which is not how anyone reads one. This drops
#                 the connector prefix and moves the arch to the end:
#
#                   cc-aarch64-ubuntu-24.04  ->  ubuntu-24.04-aarch64
#                   codbc-amd64-sles-1507    ->  sles-1507-amd64
#                   cc-amd64-windows         ->  windows-amd64
#                   cc-x86-windows           ->  windows-x86
#
#                 so a release sorts by distribution and version instead.
#
#                 A name with fewer than three fields has nothing to reorder
#                 and is passed through unchanged; quietly turning cc-windows
#                 into windows-windows would be worse than leaving it be.
#-------------------------------------------------------------------------------
STAGE_DIR_NAME() {
  local name
  local arch
  local rest
  name=$(basename "${1}")
  case ${name} in
    *-*-*)
      ;;
    *)
      echo "${name}"
      return 0
      ;;
  esac
  rest="${name#*-}"
  arch="${rest%%-*}"
  rest="${rest#*-}"
  echo "${rest}-${arch}"
}

#---  FUNCTION  ----------------------------------------------------------------
#          NAME:  CHECKSUM_AND_SIGN
#   DESCRIPTION:  Checksum and sign every package in the current directory,
#                 then collect the checksum files and the detached signatures
#                 into a checksums/ subdirectory of it, leaving the packages
#                 themselves as the only files directly in the dir.
#
#                 This is the layout prep-es builds for the package tarballs
#                 in checksum_package_tarballs, and it is what the
#                 mariadb.com CDN wants: the caller walks the release one
#                 package directory at a time, so each one ends up carrying
#                 its own checksums rather than the whole release sharing a
#                 set of sums files at the top level.
#
#                 Takes the gpg options to sign with as its only argument,
#                 since the community and enterprise keys differ.
#
#                 An existing checksums/ is removed first: re-running would
#                 otherwise append to the last run's sums files and re-sign
#                 signatures it had already made. Files already ending in
#                 .asc are left out of the list for the same reason.
#-------------------------------------------------------------------------------
CHECKSUM_AND_SIGN() {
  local sign_opts
  local files
  local sum
  local file
  sign_opts="${1}"
  files=$(find . -maxdepth 1 -type f ! -name '*.asc' | sort)
  if [ -z "${files}" ]; then
    MSG_L "Nothing to checksum in $(pwd), skipping..."
    return 0
  fi
  if [ -d checksums ]; then
    RC rm -rf checksums
  fi
  RC mkdir checksums
  for sum in md5 sha1 sha256 sha512 ; do
    MSG_L "${sum}sum ${files} >> checksums/${sum}sums.txt"
           ${sum}sum ${files} >> checksums/${sum}sums.txt
    RC ${sum}sum -c checksums/${sum}sums.txt
  done
  for file in ${files} ; do
    RC gpg ${sign_opts} ${file}
    RC mv -i ${file}.asc checksums/
  done
  # and sign the checksum files themselves, in place
  RC pushd checksums
    for file in ./*.txt ; do
      RC gpg ${sign_opts} ${file}
    done
  RC popd
}

