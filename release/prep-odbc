    # staged release sits in a directory of its own, like the ci builder
    # dirs do. Nothing is left at the top level but the checksum files.
    if [[ ! -d "${dir_name}/source" ]] ; then
      mkdir -v ${dir_name}/source
    fi
    cp -avi ${dir_build}/*src.tar.gz ${dir_name}/source/
  popd
  echo;echo;echo
