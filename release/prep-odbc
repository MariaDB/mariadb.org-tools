}

copy_win_packages_to_sign-todo_dir() {
  RC cp -avi ${dir_build}/codbc-x86-windows/*.msi ~/sign-todo/
  RC cp -avi ${dir_build}/codbc-amd64-windows/*.msi ~/sign-todo/
  RC tree ~/sign-todo/
  MSG "Quitting so Win Package signing can occur."
  MSG_L "Re-run script when signing is completed and move signed packages back."
  exit 0
}

#===  FUNCTION  ================================================================
#          NAME:  move_win_packages_from_sign-done_dir
#   DESCRIPTION:  Move the signed .msi packages out of ~/sign-done and into
#                 ${dir_win_signed}.
#
#                 They deliberately do NOT go back into the ci download dirs
#                 they came from. Everything under ${co_builds}/${tarbuildnum}
#                 is re-fetched by download_files_from_ci, and wget2 -N will
#                 pull a file again when the local copy differs in size, which
#                 a signed .msi always does -- so a later download would drop
#                 the unsigned .msi straight back on top of the signed one.
#                 ${dir_win_signed} sits beside that tree rather than inside
#                 it, so nothing download_files_from_ci does can reach it.
#===============================================================================
move_win_packages_from_sign-done_dir() {
  RC tree ~/sign-done/
  if [ ! -d ${dir_win_signed} ]; then
    mkdir -vp ${dir_win_signed}
  fi
  RC mv -vi ~/sign-done/mariadb-connector-odbc*${version}*win32.msi ${dir_win_signed}/
  RC mv -vi ~/sign-done/mariadb-connector-odbc*${version}*win64.msi ${dir_win_signed}/
  RC tree ${dir_win_signed}/
  RC tree ~/sign-done/
}

verify_signed_win_packages() {
  local missing
  missing=""
  for arch in win32 win64 ; do
    if ! compgen -G "${dir_win_signed}/*${arch}.msi" > /dev/null ; then
      missing="${missing} ${arch}"
    fi
  done
  if [ -n "${missing}" ]; then
    MSG_I "No signed${missing} .msi in ${dir_win_signed}"
    MSG_L "Both .msi packages have to be signed before the release can be"
    MSG_L "built: run the sign-todo copy, get them signed, then run the"
    MSG_L "sign-done move. Quitting..."
    exit 9
  fi
  for msi in ${dir_win_signed}/*msi ; do
    MSG "Verifying ${msi}"
    RC osslsigncode verify -in ${msi}
  done
}

