dir_log=${XDG_DATA_HOME:-~/.local/share}


#-------------------------------------------------------------------------------
#  Functions
#-------------------------------------------------------------------------------
#===  FUNCTION  ================================================================
#          NAME:  sumgen
#   DESCRIPTION:  Write md5/sha1/sha256/sha512 sums for every mariadb-* file
#                 at or below the cwd, then verify them.
#
#                 Only the org side uses this now -- the org release dir,
#                 which is flat, and where mariadb.org publishes the sums
#                 files beside the archives they cover. The com side uses
#                 CHECKSUM_AND_SIGN instead, one checksums/ dir per package
#                 dir. find turns up exactly what the old ./mar* glob did
#                 here, in the same order and with the same ./ prefix, so
#                 this sums file is byte-for-byte what it always was.
#===============================================================================
sumgen() {
  local files
  files=$(find . -type f -name 'mar*' | sort)
  if [ -z "${files}" ]; then
    # Without this the sum commands below would read stdin and just sit there.
    MSG "No mariadb-* files to checksum in $(pwd). Quitting..."
    return 1
  fi
  for sum in md5 sha1 sha256 sha512;do
	echo;LINE;echo ${sum};
	${sum}sum ${files} >> ${sum}sums.txt
	${sum}sum -c ${sum}sums.txt
  done
  DIV
}

userInput() {
  question="$@"
  echo
  read -p "${question} "
  echo
  INPUT=${REPLY}
  return 0
}

userResponse() {
  question="${@}"
  read -p "${question} " -n 1
  echo
  ANSWER=${REPLY}
  RESPONSE=${REPLY}
  return 0
}

loadDefaults() {
