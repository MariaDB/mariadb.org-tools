      # STAGE_DIR_NAME drops the codbc- prefix and moves the arch to the end so
      # that the release sorts by distribution rather than by architecture.
      # The trailing slash on the source is what makes rsync rename the dir.
      stage_dir=$(STAGE_DIR_NAME ${dir})
      case $(basename ${dir}) in
        codbc-*-windows)
          # The .msi in the ci download dir is the unsigned one. Exclude it
          # here and take the signed .msi from ${dir_win_signed} below. Not
          # using RC for this one: it runs its arguments unquoted, which would
          # let the shell expand the *.msi exclude pattern against the cwd.
          echo "+ rsync -av --exclude=index.html --exclude=*.msi ${dir}/ ${dir_name}/${stage_dir}/"
          rsync -av --exclude=index.html --exclude='*.msi' "${dir}/" "${dir_name}/${stage_dir}/"
          ;;
        *)
          RC rsync -av --exclude=index.html ${dir}/ ${dir_name}/${stage_dir}/
          ;;
      esac
      DIV
    done

    # The Windows packages are the signed ones from ${dir_win_signed}, NOT the
    # unsigned ones sitting in the ci download dir.
    if ! compgen -G "${dir_win_signed}/*msi" > /dev/null ; then
      MSG "No signed .msi in ${dir_win_signed}, refusing to stage the release"
      MSG_L "without the Windows packages. Get them signed first."
      return 1
    fi
    for msi in ${dir_win_signed}/*msi ; do
      case $(basename ${msi}) in
        *win32.msi) win_dir="windows-x86"   ;;
        *win64.msi) win_dir="windows-amd64" ;;
        *)
